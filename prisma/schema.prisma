generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  STOPPED
}

model AutomationJob {
  id          String    @id
  serviceId   String
  deviceId    String
  status      JobStatus @default(PENDING)
  progress    Int       @default(0)
  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  error       String?

  @@index([createdAt])
  @@index([deviceId, status])
}
